# Local acceptance/demo environment only. Never put shared-service credentials here.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=ntou_local
DB_PASSWORD=change_me_locally
# The acceptance/seed scripts require a NEW name beginning with ntou_acceptance_.
# Omit DB_NAME when running those scripts to generate a unique name.
# For server.py, set DB_NAME to the name reported by the seed script.
DB_NAME=ntou_acceptance_demo_change_this_name
# Explicitly authorize creating a fresh local schema; existing schemas are refused.
NTOU_ACCEPTANCE_ALLOW_CREATE=1
